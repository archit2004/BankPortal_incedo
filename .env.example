# Copy to .env and fill in. .env is gitignored; never commit it.
# Avoid the characters  ; ' " $ \  in MSSQL_SA_PASSWORD (it is embedded in a connection string).
# SQL Server requires 8+ characters from at least three of: upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=
# At least 32 characters of randomness (the API refuses to start otherwise).
JWT_KEY=
ADMIN_EMAIL=admin@bankportal.local
# 10+ characters with upper, lower, a digit and a symbol. Only used when the admin user is first created.
ADMIN_PASSWORD=
WEB_PORT=8080